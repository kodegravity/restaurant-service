{
  "family": "restaurant-service",
  "networkMode": "awsvpc",
  "requiresCompatibilities": ["FARGATE"],
  "cpu": "512",
  "memory": "1024",
  "executionRoleArn": "arn:aws:iam::YOUR_ACCOUNT_ID:role/ecsTaskExecutionRole",
  "taskRoleArn":      "arn:aws:iam::YOUR_ACCOUNT_ID:role/restaurant-service-task-role",
  "containerDefinitions": [
    {
      "name": "restaurant-service",
      "image": "YOUR_ACCOUNT_ID.dkr.ecr.us-east-2.amazonaws.com/restaurant-service:latest",
      "essential": true,
      "portMappings": [
        {
          "containerPort": 8080,
          "protocol": "tcp"
        }
      ],
      "environment": [
        { "name": "SPRING_PROFILES_ACTIVE", "value": "prod" }
      ],
      "secrets": [
        { "name": "DB_HOST",                 "valueFrom": "arn:aws:secretsmanager:us-east-2:YOUR_ACCOUNT_ID:secret:food-delivery/dev/db/credentials:host::" },
        { "name": "DB_USERNAME",             "valueFrom": "arn:aws:secretsmanager:us-east-2:YOUR_ACCOUNT_ID:secret:food-delivery/dev/db/credentials:username::" },
        { "name": "DB_PASSWORD",             "valueFrom": "arn:aws:secretsmanager:us-east-2:YOUR_ACCOUNT_ID:secret:food-delivery/dev/db/credentials:password::" },
        { "name": "DB_PORT",                 "valueFrom": "arn:aws:secretsmanager:us-east-2:YOUR_ACCOUNT_ID:secret:food-delivery/dev/db/credentials:port::" },
        { "name": "DB_NAME",                 "valueFrom": "arn:aws:secretsmanager:us-east-2:YOUR_ACCOUNT_ID:secret:food-delivery/dev/db/credentials:dbname::" },
        { "name": "KAFKA_BOOTSTRAP_SERVERS", "valueFrom": "arn:aws:ssm:us-east-2:YOUR_ACCOUNT_ID:parameter/restaurant-service/kafka-bootstrap-servers" },
        { "name": "REDIS_HOST",              "valueFrom": "arn:aws:ssm:us-east-2:YOUR_ACCOUNT_ID:parameter/restaurant-service/redis-host" },
        { "name": "REDIS_PORT",              "valueFrom": "arn:aws:ssm:us-east-2:YOUR_ACCOUNT_ID:parameter/restaurant-service/redis-port" },
        { "name": "JWT_ISSUER_URI",          "valueFrom": "arn:aws:ssm:us-east-2:YOUR_ACCOUNT_ID:parameter/restaurant-service/jwt-issuer-uri" },
        { "name": "CORS_ALLOWED_ORIGINS",    "valueFrom": "arn:aws:ssm:us-east-2:YOUR_ACCOUNT_ID:parameter/restaurant-service/cors-allowed-origins" }
      ],
      "healthCheck": {
        "command": ["CMD-SHELL", "wget -qO- http://localhost:8080/actuator/health || exit 1"],
        "interval": 30,
        "timeout": 5,
        "retries": 3,
        "startPeriod": 60
      },
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group":         "/ecs/restaurant-service",
          "awslogs-region":        "us-east-2",
          "awslogs-stream-prefix": "ecs"
        }
      }
    }
  ]
}
